# FastTrack AI Environment Variables Template
# Copy this file to .env and configure secrets accordingly.

FASTTRACK_ENV=development
FASTTRACK_LOG_LEVEL=INFO
FASTTRACK_SECRET_KEY=replace-with-a-secure-random-secret-key-minimum-32-chars
FASTTRACK_EVIDENCE_ENCRYPTION_KEY=
FASTTRACK_JWT_SECRET=replace-with-jwt-secret-key

# Storage paths
FASTTRACK_DATA_DIR=data
FASTTRACK_EVIDENCE_DIR=evidence
FASTTRACK_LOGS_DIR=logs
FASTTRACK_WEIGHTS_DIR=weights

# Optional Notifications (Internal Operator Channels Only)
FASTTRACK_TELEGRAM_BOT_TOKEN=
FASTTRACK_TELEGRAM_CHAT_ID=
FASTTRACK_WEBHOOK_URL=
FASTTRACK_SMTP_HOST=
FASTTRACK_SMTP_PORT=587
FASTTRACK_SMTP_USER=
FASTTRACK_SMTP_PASSWORD=
FASTTRACK_ALERT_EMAIL_RECIPIENT=

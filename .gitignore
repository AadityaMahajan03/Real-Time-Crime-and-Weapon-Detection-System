# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv/
venv/
ENV/
env/

# Node / Next.js
node_modules/
web/node_modules/
.next/
web/.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts

# Databases & local sqlite
*.db
*.db-wal
*.db-shm
fasttrack.db*
data/*.db
data/*.db-wal
data/*.db-shm


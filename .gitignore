evidence/
web/public/evidence/live-*
web/public/clips/live-*.mp4
clips/live-*.mp4
scratch_*
joao_paper_*

# Reports
reports/eval/*.json
!reports/eval/.gitkeep
reports/figures/*.png
!reports/figures/.gitkeep

# Model weights (large binaries)
*.pt
*.onnx
*.engine
weights/

# Logs
logs/
*.log

